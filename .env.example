# Copy to .env.local. Use a managed PostgreSQL URL with PostGIS enabled.
DATABASE_URL=
# Optional direct/session connection for migrations and trusted operator scripts.
# The Supabase shared transaction pooler is unsafe with postgres.js pipelining. Validate an
# alternative and its connection limits before production; see docs/M4_PILOT_READINESS.md.
DIRECT_URL=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Configure a trusted HTTPS origin in production.

# M2 private evidence storage. Use a private S3-compatible bucket with public access blocked.
S3_BUCKET=
S3_REGION=
# Optional for S3-compatible providers that need a custom endpoint.
S3_ENDPOINT=
# Optional when the runtime's default AWS credential chain is configured.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true only for providers that require path-style bucket addressing.
S3_FORCE_PATH_STYLE=false
# Defaults to AES256 for existing S3-compatible providers. Set explicitly empty for Supabase
# Storage S3 endpoints, which do not support the x-amz-server-side-encryption request header.
S3_SERVER_SIDE_ENCRYPTION=AES256

# Server-only Mapbox Directions access token. Without it, route ETA is unavailable.
MAPBOX_ACCESS_TOKEN=
# Optional maximum accepted GPS accuracy before a submission is flagged for review (default 100m).
GPS_MAX_ACCURACY_M=100
# M3 default; configurable per deployment/institutional policy (integer 0–1440 minutes).
CHECKIN_OVERDUE_TOLERANCE_MINUTES=30
